generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SUPER_ADMIN
  COMPANY_USER
  JOB_SEEKER
}

enum OrgRole {
  ORG_ADMIN
  DIVISION_LEAD
}

enum PlanTier {
  PAY_PER_OPREC
  SME_PRO
}

enum ApplicationStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED_SCREENING
  EVALUATED
  SHORTLISTED
  REJECTED
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  passwordHash     String
  systemRole       SystemRole          @default(JOB_SEEKER)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  memberships      OrganizationMember[]
  candidateProfile CandidateProfile?

  @@index([email])
  @@index([systemRole])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(DIVISION_LEAD)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  planTier           PlanTier             @default(PAY_PER_OPREC)
  applicantQuota     Int                  @default(100)
  cultureDescription String?              @db.Text
  isVerified         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  members            OrganizationMember[]
  jobs               JobRequisition[]
}

model CandidateProfile {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvSummaryText String           @db.Text
  portfolioUrl  String?
  skills        String[]         @default([])
  isOpenToPool  Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  applications  JobApplication[]

  @@index([isOpenToPool])
}

model JobRequisition {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  slug           String           @unique
  rawUserPrompt  String           @db.Text
  generatedSpec  Json // Validated by JobSpecSchema
  scoringRubric  Json // Validated by ScoringRubricSchema
  maxTurns       Int              @default(8)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]

  @@index([organizationId])
}

model JobApplication {
  id                 String            @id @default(cuid())
  jobId              String
  job                JobRequisition    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  status             ApplicationStatus @default(REGISTERED)
  clientIp           String? // Captured from cf-connecting-ip
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  session            InterviewSession?
  evaluation         Evaluation?

  @@unique([jobId, candidateProfileId])
  @@index([jobId, status])
  @@index([candidateProfileId])
}

model InterviewSession {
  id              String         @id @default(cuid())
  applicationId   String         @unique
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages        Json           @default("[]") // Array of { role: 'user'|'assistant', content: string, timestamp: string }
  turnCount       Int            @default(0)
  totalTokensUsed Int            @default(0)
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
}

model Evaluation {
  id                    String         @id @default(cuid())
  applicationId         String         @unique
  application           JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  matchScore            Int // 0 - 100 weighted composite
  domainScore           Int // 0 - 100
  implicitBehaviorScore Int // 0 - 100
  executiveSummary      String         @db.Text
  traitBreakdown        Json // Detailed scoring per rubric item
  greenFlags            String[]
  redFlags              String[]
  finalInterviewProbes  String[] // Suggested questions for human HR/Lead
  evalTokensUsed        Int            @default(0)
  createdAt             DateTime       @default(now())

  @@index([matchScore(sort: Desc)])
}
