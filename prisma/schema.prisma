generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SUPER_ADMIN
  COMPANY_USER
  JOB_SEEKER
}

enum OrgRole {
  ORG_ADMIN
  DIVISION_LEAD
}

enum PlanTier {
  FREE
  PAY_PER_OPREC
  SME_PRO
}

enum ApplicationStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED_SCREENING
  EVALUATED
  SHORTLISTED
  REJECTED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
}

model User {
  id               String                   @id @default(cuid())
  name             String
  email            String                   @unique
  passwordHash     String
  systemRole       SystemRole               @default(JOB_SEEKER)
  isActive         Boolean                  @default(true)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  memberships      OrganizationMember[]
  candidateProfile CandidateProfile?
  sessions         Session[]
  authTokens       AuthToken[]
  sentInvitations  OrganizationInvitation[] @relation("InvitedBy")
  invoices         Invoice[]                @relation("InvoiceCreatedBy")
  auditLogs        AuditLog[]               @relation("AuditActor")

  @@index([email])
  @@index([systemRole])
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId String?
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use tokens for email verification & password reset (hash stored only).
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(DIVISION_LEAD)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  orgRole        OrgRole      @default(DIVISION_LEAD)
  tokenHash      String       @unique
  invitedById    String?
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

model Organization {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  planTier           PlanTier                 @default(FREE)
  /// Applicant allowance for the current billing period (FREE/SME_PRO) or purchased credits (PAY_PER_OPREC).
  applicantQuota     Int                      @default(20)
  /// Applicants consumed against `applicantQuota`. Incremented atomically on every new application.
  applicantsUsed     Int                      @default(0)
  /// End of the paid SME_PRO period. When it passes, the org falls back to FREE limits.
  currentPeriodEnd   DateTime?
  billingEmail       String?
  cultureDescription String?                  @db.Text
  isVerified         Boolean                  @default(false)
  isSuspended        Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  members            OrganizationMember[]
  jobs               JobRequisition[]
  invitations        OrganizationInvitation[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
}

model CandidateProfile {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvSummaryText String           @db.Text
  portfolioUrl  String?
  skills        String[]         @default([])
  isOpenToPool  Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  applications  JobApplication[]

  @@index([isOpenToPool])
}

model JobRequisition {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  slug           String           @unique
  rawUserPrompt  String           @db.Text
  generatedSpec  Json // Validated by JobSpecSchema
  scoringRubric  Json // Validated by ScoringRubricSchema
  maxTurns       Int              @default(8)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]

  @@index([organizationId])
}

model JobApplication {
  id                 String            @id @default(cuid())
  jobId              String
  job                JobRequisition    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  status             ApplicationStatus @default(REGISTERED)
  clientIp           String? // Captured from cf-connecting-ip
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  session            InterviewSession?
  evaluation         Evaluation?

  @@unique([jobId, candidateProfileId])
  @@index([jobId, status])
  @@index([candidateProfileId])
}

model InterviewSession {
  id              String         @id @default(cuid())
  applicationId   String         @unique
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages        Json           @default("[]") // Array of { role: 'user'|'assistant', content: string, timestamp: string }
  turnCount       Int            @default(0)
  totalTokensUsed Int            @default(0)
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
}

model Evaluation {
  id                    String         @id @default(cuid())
  applicationId         String         @unique
  application           JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  matchScore            Int // 0 - 100 weighted composite
  domainScore           Int // 0 - 100
  implicitBehaviorScore Int // 0 - 100
  executiveSummary      String         @db.Text
  traitBreakdown        Json // Detailed scoring per rubric item
  greenFlags            String[]
  redFlags              String[]
  finalInterviewProbes  String[] // Suggested questions for human HR/Lead
  evalTokensUsed        Int            @default(0)
  createdAt             DateTime       @default(now())

  @@index([matchScore(sort: Desc)])
}

/// Midtrans payment / invoice record. `orderId` is the Midtrans order_id.
model Invoice {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById           String?
  createdBy             User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orderId               String        @unique
  plan                  PlanTier
  description           String
  amount                Int // IDR, integer rupiah
  quotaGranted          Int
  periodDays            Int? // For subscription plans (SME_PRO)
  status                InvoiceStatus @default(PENDING)
  snapToken             String?
  snapRedirectUrl       String?
  paymentType           String?
  midtransTransactionId String?
  rawNotification       Json?
  paidAt                DateTime?
  fulfilledAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail     String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
}
