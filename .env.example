# Database Credentials for Dedicated matchlab-db
POSTGRES_USER=matchlab
POSTGRES_PASSWORD=supersecret_aselab_password
POSTGRES_DB=matchlab_prod

# Host-accessible URL (Used by Prisma CLI / Orca on host via port 5435)
DATABASE_URL="postgresql://matchlab:supersecret_aselab_password@127.0.0.1:5435/matchlab_prod?schema=public"

# LLM Configuration
# MatchLab supports OpenRouter, Google Generative AI (Gemini), and OpenAI.
# Provider is auto-detected from key/model, or can be forced with AI_PROVIDER="openrouter" | "google" | "openai".

# --- Option A: OpenRouter (Recommended for multi-model flexibility & cost optimization) ---
OPENROUTER_API_KEY="sk-or-v1-..."
AI_PROVIDER="openrouter"
AI_MODEL_TRANSLATOR="google/gemini-2.5-flash"
AI_MODEL_INTERVIEWER="google/gemini-2.5-flash"
AI_MODEL_EVALUATOR="google/gemini-2.5-pro"
# Optional OpenRouter settings:
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_TITLE="MatchLab"
# OPENROUTER_HTTP_REFERER="https://matchlab.yourdomain.id"

# --- Option B: Google Gemini (Direct) ---
# AI_PROVIDER_API_KEY="your_api_key_here"
# AI_MODEL_TRANSLATOR="gemini-2.5-flash"
# AI_MODEL_INTERVIEWER="gemini-2.5-flash"
# AI_MODEL_EVALUATOR="gemini-2.5-pro"

# --- Option C: OpenAI (Direct) ---
# OPENAI_API_KEY="sk-..."
# AI_MODEL_TRANSLATOR="gpt-4o-mini"
# AI_MODEL_INTERVIEWER="gpt-4o-mini"
# AI_MODEL_EVALUATOR="gpt-4o"

# Public URL behind Cloudflare Tunnel
NEXT_PUBLIC_APP_URL="https://matchlab.yourdomain.id"

# ---------------------------------------------------------------------------
# SaaS configuration
# ---------------------------------------------------------------------------

# Transactional email via Resend (https://resend.com). If unset, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="MatchLab <no-reply@matchlab.yourdomain.id>"
# EMAIL_REPLY_TO="support@matchlab.yourdomain.id"

# Midtrans payments (https://dashboard.midtrans.com). Sandbox keys start with "SB-".
# Notification URL to configure in the Midtrans dashboard:
#   ${NEXT_PUBLIC_APP_URL}/api/billing/midtrans/notification
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Optional plan overrides (IDR / applicant counts)
# PLAN_FREE_QUOTA=20
# PLAN_OPREC_PRICE=149000
# PLAN_OPREC_QUOTA=150
# PLAN_PRO_PRICE=499000
# PLAN_PRO_QUOTA=750

# Legal / support contact shown on Terms & Privacy pages
SUPPORT_EMAIL="support@matchlab.yourdomain.id"
